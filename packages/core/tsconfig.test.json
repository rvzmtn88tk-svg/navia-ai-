{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "types": ["node"],
    // Multiple candidate locations for @types/node: the normal locations
    // npm install would populate (once this sandbox's blocked registry
    // access is lifted — see LIMITATIONS.md), plus this sandbox's
    // preinstalled global copy as a fallback so typechecking works today.
    // TypeScript silently skips any entry that doesn't exist.
    "typeRoots": ["./node_modules/@types", "../../node_modules/@types", "/opt/node-tools/node_modules/@types"]
  },
  "include": ["src/**/*.ts", "test/**/*.ts"]
}
