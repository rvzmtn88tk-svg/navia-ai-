# NAVIA mobile — environment template. Copy to .env and fill in for a real
# device build.
#
# IMPORTANT: Expo only inlines env vars into the JS bundle at build time if
# they're prefixed EXPO_PUBLIC_ (see https://docs.expo.dev/guides/environment-variables/).
# A plain NAVIA_* var would silently read as `undefined` at runtime — that
# was a real bug in an earlier draft of this file, fixed here. No secret
# belongs in an EXPO_PUBLIC_ var (it ends up in the shipped bundle, readable
# by anyone) — a RemoteLLMProvider key stays server-side (spec section 39).

# Optional base URL of a Valhalla routing instance for
# OnlineValhallaProvider. Defaults to the public FOSSGIS demo instance for
# individual testing; it has fair-use limits and is not a production service.
# For a public release, point this at your own Valhalla instance.
EXPO_PUBLIC_NAVIA_VALHALLA_URL=

# Backend endpoint that proxies to an LLM for RemoteLLMProvider. The mobile
# app calls THIS, never a model API directly. Leave unset to use the
# deterministic, API-key-free DeterministicDemoAIProvider (the default).
EXPO_PUBLIC_NAVIA_AI_BACKEND_URL=

# MapLibre style URL (vector tiles). Development builds use MapLibre's
# public demo style when this is unset. For production, provide your own
# online style or an offline-bundled style from scripts/data; otherwise the
# app shows a clear "map style not configured" message.
EXPO_PUBLIC_NAVIA_MAP_STYLE_URL=

# Search-as-you-type suggestions use Photon, an open-source OpenStreetMap
# geocoder. The hosted Photon demo is best-effort for individual testing only:
# it can throttle requests and has no availability guarantee. For production,
# configure a private Photon instance or another provider with an autocomplete
# service and suitable terms.
EXPO_PUBLIC_NAVIA_AUTOCOMPLETE_URL=https://photon.komoot.io/api

# Nominatim-compatible full geocoding endpoint retained for direct address
# lookups. Do not use the public Nominatim server for autocomplete; its usage
# policy prohibits that. See https://operations.osmfoundation.org/policies/nominatim/.
EXPO_PUBLIC_NAVIA_GEOCODER_URL=https://nominatim.openstreetmap.org

# Air-raid alert status API base (informational layer only — section 19).
EXPO_PUBLIC_NAVIA_AIR_ALERT_API_URL=
