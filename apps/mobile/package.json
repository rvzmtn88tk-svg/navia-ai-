{
  "name": "@navia/mobile",
  "version": "0.1.0",
  "private": true,
  "description": "NAVIA mobile app. MapLibre and speech recognition require a native build; use the iOS Release configuration for an install that does not depend on Metro. See repository BUILD.md and LIMITATIONS.md.",
  "main": "index.ts",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@maplibre/maplibre-react-native": "^10.0.0",
    "@navia/core": "*",
    "@react-native/js-polyfills": "^0.76.9",
    "@react-navigation/native": "^7.0.0",
    "@react-navigation/native-stack": "^7.0.0",
    "expo": "~52.0.0",
    "expo-av": "~15.0.2",
    "expo-haptics": "~14.0.1",
    "expo-location": "~18.0.0",
    "expo-sensors": "~14.0.0",
    "expo-speech": "~13.0.0",
    "expo-speech-recognition": "^1.0.0",
    "expo-sqlite": "~15.1.4",
    "react": "18.3.1",
    "react-native": "^0.76.9",
    "react-native-safe-area-context": "~4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-svg": "15.8.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/react": "~18.3.12",
    "typescript": "^5.6.3"
  }
}
