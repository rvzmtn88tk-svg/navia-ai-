# NAVIA AI backend configuration. Copy to your deployment's secret store /
# environment; never ship any of this in the mobile app.

# Model gateway: anthropic (default) | openai_compatible
NAVIA_LLM_PROVIDER=anthropic

# Claude API credential (read by the Anthropic SDK). Required for provider=anthropic.
# Put ONLY the key here (sk-ant-...), not a whole curl command.
ANTHROPIC_API_KEY=

# provider=openai_compatible: any OpenAI-compatible Chat Completions endpoint with
# function calling. Model names must be set below (no defaults for this provider).
NAVIA_OPENAI_BASE_URL=
NAVIA_OPENAI_API_KEY=

PORT=8787

# Tier -> model mapping (see docs/AI_COPILOT.md). Defaults shown.
NAVIA_AI_MODEL_FAST=claude-haiku-4-5
NAVIA_AI_MODEL_SMART=claude-opus-5-5
# low | medium | high | xhigh | max — smart tier only (Haiku 4.5 takes no effort).
NAVIA_AI_SMART_EFFORT=medium
NAVIA_AI_FAST_MAX_TOKENS=1024
NAVIA_AI_SMART_MAX_TOKENS=8000

# If set, the app must send "Authorization: Bearer <token>"
# (EXPO_PUBLIC_NAVIA_AI_CLIENT_TOKEN in the app). Identifies the app build;
# it is not a secret once shipped in a bundle.
NAVIA_BACKEND_CLIENT_TOKEN=

# Requests per minute per client IP (in-memory; use a shared limiter when
# running more than one instance).
NAVIA_AI_RATE_LIMIT_PER_MIN=60
