{
  "name": "navia",
  "private": true,
  "version": "0.1.0",
  "description": "NAVIA AI — resilient offline-capable navigation for Ukraine. Monorepo: packages/core (platform-independent navigation engine), apps/mobile (Expo/React Native app), scripts/data (OSM/Valhalla offline data pipeline).",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "tsx --test packages/*/test/**/*.test.ts",
    "typecheck": "tsc -b tsconfig.json && tsc --noEmit -p packages/core/tsconfig.test.json",
    "android": "npm run android --workspace=@navia/mobile --",
    "ios": "npm run ios --workspace=@navia/mobile --"
  },
  "devDependencies": {
    "tsx": "^4.23.15",
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "expo": "~52.0.49",
    "react": "18.3.1",
    "react-native": "0.76.9",
    "react-native-safe-area-context": "~4.12.0"
  }
}
